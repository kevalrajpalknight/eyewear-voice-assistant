# Copy to .env (gitignored) and fill in. Real environment variables override this file.
# Never commit .env. Values below are examples, not secrets.

# ---- LLM, main (the strong model) ----
# openai | anthropic | google | openrouter | openai_compatible
LLM_PROVIDER=openai
# No default: set the exact model id your provider documents.
LLM_MODEL=
LLM_API_KEY=
# Optional. Needed for openai_compatible; overrides the built-in URL of other providers.
LLM_BASE_URL=
LLM_TEMPERATURE=0.6
# Upper bound on generated tokens per reply (tokens)
LLM_MAX_TOKENS=1200
# Whole-request timeout (seconds)
LLM_TIMEOUT_S=30
# Retries before the first token only
LLM_MAX_RETRIES=2

# ---- LLM, fast (optional; unset fields inherit from the main LLM_* values) ----
LLM_FAST_PROVIDER=
LLM_FAST_MODEL=
LLM_FAST_API_KEY=
LLM_FAST_BASE_URL=
LLM_FAST_TEMPERATURE=
LLM_FAST_MAX_TOKENS=
LLM_FAST_TIMEOUT_S=
LLM_FAST_MAX_RETRIES=

# ---- Router ----
# off = always the main model; rules = short easy requests go to the fast model;
# model = a small classifier call decides (adds latency);
# local_first = rules, then ONE call to the local model, then the cloud when it escalates
ROUTER_MODE=rules
# Requests with at most this many words may use the fast model (words)
ROUTER_MAX_EASY_WORDS=8
# Comma list. A request containing any of these goes to the main model.
ROUTER_HARD_KEYWORDS=search,latest,news,weather,price,look,see,compare,explain in detail
# Classifier model for ROUTER_MODE=model (inherits LLM_FAST_*, then LLM_*)
ROUTER_MODEL_PROVIDER=
ROUTER_MODEL_MODEL=
ROUTER_MODEL_API_KEY=
ROUTER_MODEL_BASE_URL=
# Classifier time limit (seconds)
ROUTER_TIMEOUT_S=3
# Where to go when the classifier fails: strong | fast
ROUTER_FALLBACK=strong

# ---- Speech to text ----
# moonshine | parakeet | faster-whisper
STT_ENGINE=moonshine
# Empty = the engine's own default. moonshine: tiny, base, small-v2, medium-v2.
# faster-whisper: base.en, small.en, small. parakeet: ignored.
STT_MODEL=
# faster-whisper compute type
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
# CPU threads
STT_THREADS=4
# Pass glossary terms to engines that accept hints (faster-whisper)
STT_HINTS_ENABLED=false
# Fix glossary names after recognition
GLOSSARY_ENABLED=false
GLOSSARY_PATH=bench/data/glossary.txt
# Fuzzy match threshold, 0 to 100 (higher = more careful)
GLOSSARY_THRESHOLD=88

# ---- Text to speech ----
# kokoro | piper (piper: TTS_VOICE is a registry model name, e.g. piper-en-gb-alba-medium)
TTS_ENGINE=kokoro
# int8 | fp32
TTS_VARIANT=int8
TTS_VOICE=bf_isabella
# 1.0 = normal speed
TTS_SPEED=1.05
# Silence between spoken sentences and at commas (seconds); raise for a calmer rhythm
TTS_SENTENCE_PAUSE_S=0.3
TTS_CLAUSE_PAUSE_S=0.12
# Voice: one id, or a blend like bf_isabella:0.6+bf_emma:0.4
# Words in the first spoken clause; fewer = sound starts sooner
TTS_FIRST_CLAUSE_MAX_WORDS=6
TTS_MODEL_DIR=bench/models
# Where the speech-to-text models live
STT_MODEL_DIR=bench/models

# ---- Audio and session ----
# pc | glasses (glasses is unsupported until pairing and falls back to pc)
AUDIO_OUTPUT=pc
# Volume ceiling, 0 to 1 (1 = no attenuation)
AUDIO_VOLUME_LIMIT=1.0
# A rear click within this many seconds after a cut-off request is joined to it (seconds)
TURN_JOIN_WINDOW_S=4

# ---- Identity and wake phrases ----
ASSISTANT_NAME=EVA
ASSISTANT_NAME_LONG=Eyewear Voice Assistant
# Spoken once when the assistant is ready. Empty = silent.
STARTUP_LINE=
# button = the rear click starts a request; glasses_phrase = the glasses' own wake phrase (untested);
# hfp_experimental = continuous listening through the headset microphone (NOT implemented)
WAKE_MODE=button
# true = ignore anything that does not start with "EVA", "hey EVA", "hello EVA" or "EVA listen"
WAKE_REQUIRED=false
# Empty = the wake_phrases.yaml shipped in the package
WAKE_PHRASES_PATH=
# Said when only the wake phrase was heard
WAKE_ACK=Yes?
# Reserved: a listening window after a reply (needs a safe way to restart voice sessions)
FOLLOWUP_WINDOW_S=0

# ---- Assistant ----
# Markdown persona file. Empty = the persona shipped in the package.
PERSONA_PATH=
# IANA time zone for "what time is it"
ASSISTANT_TIMEZONE=Asia/Kolkata
MAX_TURNS_PER_SESSION=50
# Longest spoken reply (seconds of speech); the rest is dropped
MAX_REPLY_SECONDS=60

# ---- Logging and privacy ----
LOG_LEVEL=INFO
# false = logs hold only lengths and timings, never what you said or what it replied
LOG_TRANSCRIPTS=false
# Print what was heard (you:) and what is said (EVA:) on screen; never written to log files
SHOW_TRANSCRIPTS=true
# button = the rear click starts a request; mic = listen all the time, wake phrase, talk both ways
INPUT_MODE=button
# agent = LangChain agent (tools, multi-step, cloud on demand); lanes = the older fixed lanes
AGENT_ENGINE=agent
# Names learned from your own voice by `assistant wake-train` (local file, never committed)
WAKE_LEARNED_PATH=captures/wake_learned.yaml
# Part of an input device name (empty = the system default microphone)
MIC_DEVICE=
# Awake and silent this long (seconds): go back to sleep
LISTEN_IDLE_SLEEP_S=3
# Speaking over the assistant stops it (false = it does not listen while it talks)
DUPLEX_BARGE_IN=true
# While it talks, your voice must be this many times louder than the room
BARGE_IN_RATIO=2.5
# Voice detector: quietest speech level (int16 RMS), times above room noise, quiet that ends a request (ms)
VAD_MIN_RMS=120
VAD_RATIO=3
VAD_END_SILENCE_MS=800
DEBUG_SAVE_AUDIO=false

# ---- Memory (RAM only; the same format feeds every lane) ----
# Exchanges kept; the old name HISTORY_TURNS still works. Whichever of turns or age is hit first.
MEMORY_MAX_TURNS=10
# Forget exchanges older than this (seconds)
MEMORY_TTL_S=600
# Token cap for the local model's context (tokens)
MEMORY_MAX_TOKENS=1500

# ---- Reply length ----
REPLY_TARGET_SENTENCES=3
# Soft limit: past this many sentences the reply is wrapped up (never cut mid-sentence)
REPLY_SOFT_MAX_SENTENCES=8
# First spoken chunk: the first sentence, or a comma boundary after this many words
FIRST_CHUNK_MIN_WORDS=8
# Spoken when a reply is wrapped up or the provider ran out of tokens
WRAP_UP_LINE=Do you want me to go on?

# ---- Local model (llama.cpp server on 127.0.0.1) ----
LOCAL_LLM_BIN_DIR=tools/llama.cpp
# A name from the model registry (aiglasses models list). Empty = no local model.
LOCAL_LLM_MODEL=
# Empty = physical cores
LOCAL_LLM_THREADS=
# Context window (tokens)
LOCAL_LLM_CTX=4096
LOCAL_LLM_PORT=8081
LOCAL_LLM_BATCH=512
# Tokens per local step (one step is a short JSON object)
LOCAL_LLM_MAX_TOKENS=120
# Start and warm up the server when `assistant run` starts
LOCAL_LLM_PRELOAD=true
# Reuse the processed prompt prefix between turns
LOCAL_LLM_PROMPT_CACHE=true
# Escalate to the cloud if the local model has no first token after this long (seconds)
LOCAL_FIRST_TOKEN_TIMEOUT_S=10
MODELS_DIR=models
MODEL_REGISTRY_PATH=src/aiglasses/assistant/models.yaml
# `models pull` refuses to go beyond this total (gigabytes)
MODEL_DOWNLOAD_BUDGET_GB=8
# Spoken while the cloud answers after an escalation
# Empty = a random short phrase from assistant/fillers.yaml; set text here to always say that
ESCALATION_FILLER=

# ---- Agent loop and tools ----
# Local steps per turn; hard cap, at most 10
AGENT_MAX_STEPS=6
# Local agent time limit per turn (seconds)
AGENT_TIME_BUDGET_S=60
# One local step (a sentence or a tool call): tokens, and seconds including the prompt
AGENT_LOCAL_MAX_TOKENS=220
LOCAL_STEP_TIMEOUT_S=20
# Comma list of tools the model may call. Recording tools also need ALLOW_RECORDING_TOOLS.
TOOLS_ENABLED=search_web,get_time,get_weather,take_photo,read_battery,read_media_counts,forget_all_that,describe_scene
TOOL_MAX_CALLS_PER_TURN=3
TOOL_TIMEOUT_S=30
ALLOW_RECORDING_TOOLS=false
# "Open the camera": false = take the photo at once, true = ask first
CAMERA_OPEN_ASKS_FIRST=false
# Photo limits
PHOTO_MIN_INTERVAL_S=10
PHOTO_MAX_PER_SESSION=10
# Device intents file. Empty = the file shipped in the package.
INTENTS_PATH=
# Trailing silence that marks a request as finished (milliseconds)
TURN_END_SILENCE_MS=300

# ---- Search ----
SEARCH_PROVIDER=ddgs
# Characters of search text the local model reads (shorter = faster)
SEARCH_CONTEXT_CHARS=700
# Second source when the first search fails: wikipedia | off
SEARCH_FALLBACK=wikipedia
SEARCH_FALLBACK_URL=https://en.wikipedia.org/w/api.php
SEARCH_MAX_RESULTS=5
SEARCH_REGION=wt-wt
# Repeat searches within this time reuse the answer (seconds)
SEARCH_CACHE_TTL_S=300
SEARCH_TIMEOUT_S=6

# ---- Weather (free public forecast service, no key) ----
# City used when you do not say one. Empty = the assistant asks.
WEATHER_LOCATION=gwalior
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# ---- Vision ----
# off | local | cloud (cloud sends the image to your provider; off by default)
VISION_PROVIDER=off
# Cloud vision also needs this to be true (images leave this PC)
VISION_ALLOW_CLOUD=false
# wait = wait for your rear double click; ai_photo = the glasses take the photo (hands-free)
VISION_CAPTURE=wait
VISION_CAPTURE_WAIT_S=30
# Longest image side sent to a model (pixels)
VISION_MAX_IMAGE_SIDE=768

# ---- Live calls through `assistant check` ----
# Lifetime number of real provider or search calls; reset with `assistant check --reset-live-budget`
LIVE_CALL_BUDGET=3

# Extra reasoning effort hint for models that support it (empty = do not send)
LLM_REASONING_EFFORT=
LLM_FAST_REASONING_EFFORT=

# ---- Spoken fallback lines ----
FALLBACK_LLM_ERROR=Sorry, I could not reach my brain just now. Please try again.
FALLBACK_NO_SPEECH=Sorry, I did not catch that. Could you say it again?
FALLBACK_TTS_ERROR=Sorry, I lost my voice for a moment.
